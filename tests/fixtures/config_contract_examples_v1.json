{
  "contract_version": "v1",
  "document": "docs/notes/config-file-contract.md",
  "pinned_by": "tests/config_contract.rs",
  "readme": "README.md",
  "keys": [
    {
      "name": "model",
      "toml_type": "string",
      "builtin_default": "claude-sonnet-4-6",
      "cli_flag": "--model, -m"
    },
    {
      "name": "inherit_hooks",
      "toml_type": "boolean",
      "builtin_default": true,
      "cli_flag": "--no-inherit-hooks"
    },
    {
      "name": "max_turns",
      "toml_type": "integer (`u32`)",
      "builtin_default": 30,
      "cli_flag": "--max-turns"
    },
    {
      "name": "timeout_secs",
      "toml_type": "integer (`u64`)",
      "builtin_default": 3600,
      "cli_flag": "--timeout"
    }
  ],
  "default_path": [
    {
      "id": "xdg-wins-over-home",
      "xdg": "set",
      "home": "set",
      "expect_path": "{xdg}/claude-print/config.toml"
    },
    {
      "id": "home-fallback-when-xdg-unset",
      "xdg": "unset",
      "home": "set",
      "expect_path": "{home}/.config/claude-print/config.toml"
    },
    {
      "id": "xdg-empty-used-as-set",
      "xdg": "empty",
      "home": "set",
      "expect_path": "claude-print/config.toml"
    },
    {
      "id": "xdg-non-utf8-falls-back-to-home",
      "xdg": "non-utf8",
      "home": "set",
      "expect_path": "{home}/.config/claude-print/config.toml"
    },
    {
      "id": "unset-home-errors",
      "xdg": "unset",
      "home": "unset",
      "documented": true,
      "also_in_readme": true,
      "expect_error": "invalid config: HOME environment variable not set or empty; set HOME to the user's home directory"
    }
  ],
