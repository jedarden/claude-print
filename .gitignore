# Rust build artifacts
target/

# Bead-forge database backups
.beads/beads.db.backup.*

# Bead-forge transient tracking files
.beads/.bf_history/
.beads/beads.base.jsonl
.beads/events.jsonl
.beads/issues.jsonl

# NEEDLE worker artifacts
.needle-predispatch-sha
.force_local

# NEEDLE worker worktrees ( Claude Code session isolation)
.claude/worktrees/

# Escaped-home-path hazard: a worker bug can create a literal '~' directory at
# the repo root. If that gets committed, a careless 'rm -rf ~' run from the repo
# root becomes catastrophic. Anchored to root so only a repo-root '~' is ignored
# (a '~' legitimately nested deeper in the tree is left alone).
/~

# NEEDLE execution traces are local diagnostics.
**/.beads/traces/

# Local NEEDLE and bead runtime state
.needle-predispatch-sha
.beads/events.jsonl
.beads/heartbeats.jsonl
.beads/diagnostics/
.beads/logs/
.beads/traces/
.beads/receipts/
.beads/*.db
.beads/*.db-shm
.beads/*.db-wal
.beads/*.db.backup.*
.beads/*.lock
.beads/*.tmp
.beads/*.temp
.beads/*.journal
.br_recovery/
